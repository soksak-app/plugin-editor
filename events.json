{
  "schema": 3,
  "layers": [
    "plugin"
  ],
  "events": {
    "plugin.editor.open": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "info",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "number"
          },
          "lines": {
            "type": "number"
          },
          "newline": {
            "type": [
              "string",
              "null"
            ]
          },
          "read_only": {
            "type": "boolean"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "lines",
          "newline",
          "read_only",
          "micros",
          "ok"
        ]
      },
      "description": "The first read of the file and its load into the document. bytes and lines are those of the document; error names a failed read."
    },
    "plugin.editor.new": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "description": "A tab without params.path opened a blank document; name is the file name that its first save proposes."
    },
    "plugin.editor.place": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "info",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "micros",
          "ok"
        ]
      },
      "description": "The answer of core.file.place at the first save of a blank document: path is the chosen file relative to the project root, or null when the person cancelled; error names a refused place."
    },
    "plugin.editor.read": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "debug",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "bytes": {
            "type": "number"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason",
          "bytes",
          "micros",
          "ok"
        ]
      },
      "description": "A later read of the file: reason is reload (the command) or watch (a change on disk)."
    },
    "plugin.editor.save": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "info",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "number"
          },
          "overwrite": {
            "type": "boolean"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "overwrite",
          "micros",
          "ok"
        ]
      },
      "description": "A write of the document in place; overwrite is true when the person chose to overwrite a file that changed on disk."
    },
    "plugin.editor.watch.start": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": [
        "info",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "micros",
          "ok"
        ]
      },
      "description": "The request to the files sidecar to watch the file."
    },
    "plugin.editor.watch.change": {
      "layer": "plugin",
      "class": "io",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "description": "The files sidecar reported a change of a watched file."
    },
    "plugin.editor.watch.error": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "error"
        ]
      },
      "description": "The files sidecar stopped the watch and reported why."
    },
    "plugin.editor.disk.decision": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "modified": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "decision",
          "modified"
        ]
      },
      "description": "What the editor decided after a read that followed a change on disk: same (the version did not change), loaded (the document had no changes and took the file) or conflict (the document has changes, so the banner asks the person)."
    },
    "plugin.editor.format": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "info",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "formatter": {
            "type": [
              "string",
              "null"
            ]
          },
          "changed": {
            "type": "boolean"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "formatter",
          "changed",
          "micros",
          "ok"
        ]
      },
      "description": "One run of the formatter of editor.formatter for the file; formatter is the plugin that contributed it."
    },
    "plugin.editor.find.invalid": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "description": "The query of the find bar is not a valid regular expression; error is the message of the expression error, which the bar shows."
    },
    "plugin.editor.markdown.image": {
      "layer": "plugin",
      "class": "io",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason",
          "error"
        ]
      },
      "description": "A Markdown preview failed to read its images after the tab showed no result: reason is disposed (the tab ended first) or superseded (a later preview replaced it); error is the failure of the read."
    },
    "plugin.editor.view.content_frame": {
      "layer": "plugin",
      "class": "frame",
      "level": "trace",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "width": { "type": "number", "minimum": 0 },
          "height": { "type": "number", "minimum": 0 },
          "documentTimeOriginMs": { "type": "number", "minimum": 0 },
          "resizeAtMs": { "type": "number", "minimum": 0 },
          "frameTimeMs": { "type": "number", "minimum": 0 },
          "surface": { "type": "string" }
        },
        "required": ["sequence", "width", "height", "documentTimeOriginMs", "resizeAtMs", "frameTimeMs", "surface"],
        "additionalProperties": false
      },
      "description": "A diagnostic-only document root size was read at the next animation frame after ResizeObserver, with timestamps from the editor view document clock; surface is added by the view runtime."
    },
    "plugin.editor.page.error": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "where": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "where",
          "error"
        ]
      },
      "description": "An error of the view page: where is page (an uncaught error), rejection (an unhandled rejection), mount (the mount of the editor failed), calls (a call of the view was lost) or context (a call of the surface context was refused)."
    },
    "plugin.editor.contribution.failed": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "point": {
            "type": "string"
          },
          "plugin": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "point",
          "plugin",
          "error"
        ]
      },
      "description": "A contribution to editor.extension or editor.formatter failed to load or build and was left out."
    },
    "plugin.editor.command": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "debug",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "micros",
          "ok"
        ]
      },
      "description": "The result of a declared command of the editor."
    },
    "plugin.editor.request": {
      "layer": "plugin",
      "class": "io",
      "level": [
        "debug",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "micros": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "operation",
          "id",
          "micros",
          "ok"
        ]
      },
      "description": "A request to the files sidecar and its reply; error is the failure of the send or the error of the reply."
    },
    "plugin.editor.close": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "pending": {
            "type": "number"
          }
        },
        "required": [
          "path",
          "pending"
        ]
      },
      "description": "The editor surface ended; pending is the number of requests to the files sidecar that had no reply. path is null for a blank document that was never saved."
    }
  }
}
