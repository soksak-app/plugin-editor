{
  "module": "ui/editor-diagnostics.js",
  "exposes": {
    "commands": [
      {
        "name": "editor.memory.hidden",
        "description": "Mounts, reads or removes one hidden maintained CodeMirror editor instance for the editor process footprint measurement.",
        "params": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["mount", "read", "remove"] }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "mounted": { "type": "boolean" },
            "documentLength": { "type": "integer" },
            "lines": { "type": "integer" },
            "historyEntries": { "type": "integer" },
            "regionHistoryEntries": { "type": "integer" }
          }
        }
      },
      {
        "name": "editor.diagnostics.content-trace",
        "description": "Starts or stops post-layout observation of the editor view document root and reads its current dimensions.",
        "params": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["start", "stop", "read"] }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "sequence": { "type": "integer" },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "historyEntries": { "type": "integer" },
            "regionHistoryEntries": { "type": "integer" }
          }
        }
      }
    ]
  }
}
